<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>OffWithTheirNuts</AssemblyName>
    <RootNamespace>OffWithTheirNuts</RootNamespace>
    <LangVersion>8.0</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ValheimReferenceRoot Condition="'$(ValheimReferenceRoot)' == ''">$(MSBuildThisFileDirectory)../../tools/valheim-1.0.21-refs</ValheimReferenceRoot>
    <ValheimManagedDir>$(ValheimReferenceRoot)/valheim.app/Contents/Resources/Data/Managed</ValheimManagedDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim" HintPath="$(ValheimManagedDir)/assembly_valheim.dll" />
    <Reference Include="assembly_utils" HintPath="$(ValheimManagedDir)/assembly_utils.dll" />
    <Reference Include="UnityEngine" HintPath="$(ValheimManagedDir)/UnityEngine.dll" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(ValheimManagedDir)/UnityEngine.AudioModule.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ValheimManagedDir)/UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ValheimManagedDir)/UnityEngine.IMGUIModule.dll" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ValheimManagedDir)/UnityEngine.PhysicsModule.dll" />
    <Reference Include="Unity.InputSystem" HintPath="$(ValheimManagedDir)/Unity.InputSystem.dll" />
    <Reference Include="BepInEx" HintPath="$(ValheimReferenceRoot)/BepInEx/core/BepInEx.dll" />
    <Reference Include="0Harmony" HintPath="$(ValheimReferenceRoot)/BepInEx/core/0Harmony.dll" />
    <Reference Include="Jotunn" HintPath="$(ValheimReferenceRoot)/BepInEx/plugins/ValheimModding-Jotunn/Jotunn.dll" />
  </ItemGroup>

  <Target Name="CheckValheimReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ValheimManagedDir)/assembly_valheim.dll')"
           Text="Set ValheimReferenceRoot to a directory containing the Valheim and BepInEx reference assemblies." />
  </Target>

</Project>
